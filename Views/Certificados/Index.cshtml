@model IEnumerable<Sistema.Models.Certificado>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CodigoUnico)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaEmision)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CalificacionFinal)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.InscripcionId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Inscripcion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.CodigoUnico)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaEmision)
            </td>
            <td>
                @Html.DisplayFor(model => item.CalificacionFinal)
            </td>
            <td>
                @Html.DisplayFor(model => item.InscripcionId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Inscripcion)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
